<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="125dp">

    <TextView
        android:id="@+id/product_in_cart_name"
        android:layout_width="140dp"
        android:layout_height="37dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="as as das dfg nlnlkn alskfjl asfjn asflkhjn asflkha fslahf asf jhaksj fnas fjhasf ,jhasf"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/product_in_cart_image"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:layout_constraintStart_toEndOf="@+id/product_in_cart_name"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/product_in_cart_cost"
        android:textColor="#000000"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="11800 р"
        app:layout_constraintStart_toEndOf="@+id/product_in_cart_image"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/product_in_cart_logo"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:layout_constraintStart_toEndOf="@+id/product_in_cart_cost"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/paterocka" />

    <TextView
        android:id="@+id/product_in_cart_amount"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="12"
        android:textColor="#000000"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/product_in_cart_amount_minus"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/product_in_cart_weight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginTop="10dp"
        android:text="100г"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_in_cart_image" />

    <TextView
        android:id="@+id/product_in_cart_amount_shops"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="250dp"
        android:textColor="#000000"
        android:layout_marginTop="10dp"
        android:text="3/4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_in_cart_logo" />

    <ImageButton
        android:id="@+id/product_in_cart_amount_minus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#FFFFFF"
        android:layout_marginTop="2dp"
        android:src="@drawable/baseline_keyboard_arrow_left_24"
        app:layout_constraintStart_toEndOf="@+id/product_in_cart_logo"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/product_in_cart_amount_plus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:background="#FFFFFF"
        android:src="@drawable/baseline_keyboard_arrow_right_24"
        app:layout_constraintStart_toEndOf="@+id/product_in_cart_amount"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>