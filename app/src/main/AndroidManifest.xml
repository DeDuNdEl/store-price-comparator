<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/project_logo"
        android:label="Сравнение цен на продукты МО"
        android:roundIcon="@drawable/project_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sravivatel"
        tools:targetApi="34">
        <activity
            android:name=".FilterActivity"
            android:exported="false"
            android:label="@string/title_activity_filter"
            android:theme="@style/Theme.Sravivatel" />
        <activity
            android:name=".CartActivity"
            android:exported="false" />
        <activity
            android:name=".ui.theme.CartActivity"
            android:exported="false"
            android:label="@string/title_activity_cart"
            android:theme="@style/Theme.Sravivatel" />
        <activity
            android:name=".ProductInfoActivity"
            android:exported="false"
            android:label="@string/title_activity_product_info"
            android:theme="@style/Theme.Sravivatel" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>